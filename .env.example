# Leave DATABASE_URL empty to use an embedded PGlite database in ./.data (local development only).
DATABASE_URL=postgres://trust:trust@localhost:5432/trust

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Separate 32+ char key that encrypts MFA secrets at rest. Never rotate it casually: users would need to re-enrol MFA.
MFA_ENC_KEY=change-me-to-another-long-random-string

# Where uploaded evidence files are stored (S3 comes in a later phase).
UPLOAD_DIR=./uploads
