# Leave DATABASE_URL empty to use an embedded PGlite database in ./.data (local development only).
DATABASE_URL=postgres://trust:trust@localhost:5432/trust

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Separate 32+ char key that encrypts MFA secrets at rest. Never rotate it casually: users would need to re-enrol MFA.
MFA_ENC_KEY=change-me-to-another-long-random-string

# Where uploaded evidence files are stored (S3 comes in a later phase).
UPLOAD_DIR=./uploads

# AI policy drafting (optional). Without a key, drafts come from built-in templates.
# Each workspace must also turn AI drafting on (Policies page) before anything is sent.
ANTHROPIC_API_KEY=
# Model used for drafting; change without a code change.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Public base URL, used in invite and reset links and in emails (e.g. https://trust.cyberhelpasia.com).
APP_URL=

# Email (optional). Without SMTP_HOST, invites and resets show a link in the app instead of emailing.
EMAIL_FROM=CyberHELP Asia Trust <no-reply@cyberhelpasia.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Evidence storage. STORAGE_DRIVER=local (default) keeps files on disk in UPLOAD_DIR.
# Set STORAGE_DRIVER=s3 to use an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# For Singapore data residency on AWS, use S3_REGION=ap-southeast-1. Leave S3_ENDPOINT empty for
# AWS; set it for other providers (and S3_FORCE_PATH_STYLE=true for MinIO-style endpoints).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
